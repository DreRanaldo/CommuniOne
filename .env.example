# CommuniOne environment variables: NAMES ONLY, never real values.
#
# Copy to `.env.local` (git-ignored) and fill in values from
#   Supabase dashboard -> Project Settings -> API (URL and keys)
# For local development run `npx supabase status` instead.
#
# See docs/deployment/supabase-auth.md.

# --- Client-safe (may ship in the React Native / web bundle) ---------------
# The anon/publishable key is designed to be public: every request it makes
# is still subject to Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Deep link that Supabase Auth redirects to after email confirmation /
# password reset. Must be listed in Auth -> URL Configuration -> Redirect URLs.
EXPO_PUBLIC_AUTH_REDIRECT_URL=communione://auth/callback

# --- SERVER ONLY: never in the app, a client bundle, git, or a committed file
# The service-role key BYPASSES Row Level Security. Only trusted backend code
# (Edge Functions, scheduled jobs) may use it. Never prefix it with
# EXPO_PUBLIC_ / NEXT_PUBLIC_ (that would embed it in the client bundle).
SUPABASE_SERVICE_ROLE_KEY=
# Only needed to link the CLI to the hosted project (supabase link / db push).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
