{
  "name": "@communione/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CommuniOne mobile app (Expo / React Native).",
  "main": "index.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage=false",
    "config:check": "node scripts/check-config.mjs",
    "export:check": "node scripts/export-check.mjs",
    "doctor": "expo-doctor",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci && npm run config:check && npm run export:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@supabase/supabase-js": "2.117.3",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.1",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "3.9.10",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  }
}
