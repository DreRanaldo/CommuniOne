# CommuniOne mobile app: PUBLIC configuration only.
#
# Copy to .env.local (git-ignored). Expo inlines EXPO_PUBLIC_* values into the
# app bundle, so ONLY values that are safe to publish may use that prefix.
#
#   Local Supabase:  npx supabase status   (run at the repository root)
#   Hosted project:  Supabase dashboard -> Project Settings -> API
#
# NEVER put the service-role key, a database password or any other secret in
# this app. The app refuses to start with a service-role key.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
